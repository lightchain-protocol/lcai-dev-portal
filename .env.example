# Copy this file to .env and fill in the values below.

# Example API key
# API_SECRET=sk_hello_world

# Optional: override the nav and footer config endpoints (e.g. when pointing
# at a staging docs site). Defaults match production and apply if unset.
# NEXT_PUBLIC_NAV_CONFIG_URL=https://docs.lightchain.ai/nav-config.json
# NEXT_PUBLIC_FOOTER_CONFIG_URL=https://docs.lightchain.ai/footer-config.json
